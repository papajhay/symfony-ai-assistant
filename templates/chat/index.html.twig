<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Symfony AI Assistant</title>
    <style>
        :root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#e8edf6;background:#0b1020;font-synthesis:none}*{box-sizing:border-box}body{margin:0;min-height:100vh}.layout{display:grid;grid-template-columns:260px 1fr;min-height:100vh}.sidebar{padding:24px 18px;background:#101729;border-right:1px solid #263149}.brand{font-weight:750;font-size:16px;letter-spacing:-.02em;margin:4px 8px 30px}.brand span{color:#9b8cff}.new-chat{width:100%;padding:12px;border:1px solid #384460;background:#1a2337;color:#f7f8fc;border-radius:10px;font-weight:600;cursor:pointer}.side-note{margin:24px 8px;color:#8390a8;font-size:13px;line-height:1.6}.main{display:flex;flex-direction:column;min-width:0;min-height:100vh}.topbar{height:68px;padding:0 28px;display:flex;align-items:center;border-bottom:1px solid #202b40;font-size:14px;color:#aab5c9}.thread{width:min(850px,100%);margin:0 auto;padding:44px 24px 30px;flex:1}.welcome{text-align:center;margin:10vh auto 0;max-width:560px}.welcome .mark{display:grid;place-items:center;width:52px;height:52px;margin:0 auto 22px;background:#262145;color:#c9baff;border-radius:16px;font-size:24px}.welcome h1{font-size:32px;letter-spacing:-.04em;margin:0 0 12px}.welcome p{color:#9ca9bd;line-height:1.6;margin:0}.messages{display:grid;gap:24px}.message{display:flex;gap:12px;align-items:flex-start;line-height:1.65}.avatar{width:30px;height:30px;flex:0 0 30px;border-radius:9px;display:grid;place-items:center;background:#272343;color:#c7baff;font-size:12px;font-weight:700}.message.user .avatar{background:#193b38;color:#89e0cf}.content{min-width:0;max-width:100%;padding:3px 0;overflow-wrap:anywhere}.content p{margin:0 0 12px}.content pre{white-space:pre-wrap;background:#111a2b;border:1px solid #2b3851;border-radius:9px;padding:14px;overflow:auto}.content code{font-family:ui-monospace,SFMono-Regular,monospace;background:#1b263a;border-radius:4px;padding:2px 5px}.content pre code{padding:0;background:none}.composer-wrap{padding:12px 24px 28px}.composer{width:min(800px,100%);margin:auto;border:1px solid #35415b;background:#141d30;border-radius:14px;padding:10px;box-shadow:0 12px 40px #0003}.composer textarea{display:block;width:100%;min-height:56px;max-height:180px;resize:vertical;background:transparent;border:0;outline:0;color:#f4f6fb;font:inherit;padding:8px}.composer textarea::placeholder{color:#7f8ca3}.compose-row{display:flex;align-items:center;justify-content:space-between;padding:3px 2px 0 8px;color:#7f8ca3;font-size:12px}.send{border:0;border-radius:9px;background:#8b7aff;color:white;width:38px;height:36px;font-size:18px;cursor:pointer}.send:disabled{opacity:.45;cursor:wait}.error{color:#ff9d9d;padding:8px 0}.typing{color:#97a4ba;font-size:14px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:700px){.layout{grid-template-columns:1fr}.sidebar{padding:12px 16px;border-right:0;border-bottom:1px solid #263149;display:flex;align-items:center;gap:14px}.brand{margin:0;flex:1}.new-chat{width:auto;padding:9px 12px}.side-note{display:none}.topbar{height:52px;padding:0 18px}.thread{padding:28px 18px}.welcome{margin-top:8vh}.welcome h1{font-size:27px}.composer-wrap{padding:8px 14px 18px}}
    </style>
</head>
<body>
<div class="layout" data-controller="chat" data-chat-endpoint-value="{{ path('app_chat') }}" data-action="keydown.enter->chat#enter">
    <aside class="sidebar">
        <div class="brand"><span>✳</span> Symfony AI Assistant</div>
        <button class="new-chat" type="button" data-action="chat#newConversation" aria-label="Nouvelle conversation">＋ Nouvelle conversation</button>
        <p class="side-note">Assistant technique propulsé par Symfony AI et Ollama. Les réponses s’appuient sur la documentation locale.</p>
    </aside>
    <main class="main">
        <header class="topbar">Assistant Symfony <span aria-hidden="true">&nbsp;·&nbsp;</span> RAG local</header>
        <section class="thread" aria-live="polite" aria-label="Conversation">
            <div class="welcome" data-chat-target="welcome">
                <div class="mark" aria-hidden="true">✳</div>
                <h1>Comment puis-je vous aider&nbsp;?</h1>
                <p>Posez une question sur Symfony ou Symfony AI. L’assistant cherchera dans les documents disponibles.</p>
            </div>
            <div class="messages" data-chat-target="messages"></div>
            <div class="typing" data-chat-target="loading" hidden>Ollama prépare une réponse…</div>
            <div class="error" data-chat-target="error" role="alert" hidden></div>
        </section>
        <div class="composer-wrap">
            <form class="composer" data-action="submit->chat#send">
                <label class="sr-only" for="question">Votre question</label>
                <textarea id="question" data-chat-target="input" placeholder="Posez votre question…" rows="2" autocomplete="off"></textarea>
                <div class="compose-row"><span>Entrée pour envoyer · Maj + Entrée pour une nouvelle ligne</span><button class="send" type="submit" data-chat-target="send" aria-label="Envoyer" title="Envoyer">↑</button></div>
            </form>
        </div>
    </main>
</div>
<script type="module" src="/assets/controllers/chat_controller.js"></script>
</body>
</html>
